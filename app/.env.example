# ==============================================================================
# Kantin Cerdas Flutter App — Public Build-Time Configuration Template
# ==============================================================================
# File ini BUKAN dimuat otomatis oleh runtime Flutter, melainkan referensi resmi
# seluruh konfigurasi build-time (`--dart-define` dan env Gradle) yang dibaca
# oleh aplikasi Flutter (`app/lib/`) dan Android (`app/android/app/build.gradle.kts`).
# Target distribusi aplikasi: GitHub Actions Artifacts & GitHub Releases (APK).
#
# ATURAN KEAMANAN MUTLAK:
# - Seluruh nilai di Flutter APK bersifat PUBLIK (dapat diekstrak dari binary).
# - JANGAN PERNAH memasukkan `SUPABASE_SECRET_KEY`, `GEMINI_API_KEY`,
#   `FCM_PRIVATE_KEY`, Google OAuth Client Secret, atau password keystore di sini!
# - Proyek Supabase baru telah dibuat: gunakan URL proyek Supabase baru Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Build-Time yang Dibaca Kode Flutter & Android Gradle
# ------------------------------------------------------------------------------

# URL HTTPS backend Dart Shelf (WAJIB HTTPS nyata pada APK Release; bisa memakai
# subdomain gratis Railway tanpa perlu domain berbayar).
# Dibaca oleh:
# - app/lib/features/auth/application/providers/auth_repository_provider.dart
# - app/lib/features/customer/application/customer_providers.dart
# Development Android emulator: boleh dikosongkan (fallback http://10.0.2.2:8080).
API_BASE_URL=https://<your-railway-service>.up.railway.app

# Hostname HTTPS untuk Android App Links (OPSIONAL — kosongkan bila belum punya
# domain khusus; build APK tetap bekerja penuh tanpa domain berbayar!).
# Dibaca oleh:
# - app/android/app/build.gradle.kts (Gradle env `AUTH_EMAIL_LINK_HOST`,
#   fallback sentinel non-routable `auth.kantincerdas.invalid`)
# - app/lib/features/auth/application/providers/auth_email_links_provider.dart
#   (`--dart-define=AUTH_EMAIL_LINK_HOST=...`; bila kosong, HTTPS App Links
#   nonaktif aman sementara custom scheme `id.kantincerdas.oauth://auth/google`
#   dan `id.kantincerdas.oauth://auth/verify-email` tetap berjalan).
AUTH_EMAIL_LINK_HOST=

# Feature flag Google Sign-In PKCE pada sisi klien Flutter.
# Dibaca oleh: app/lib/features/auth/application/providers/google_oauth_provider.dart
# Redirect URL Supabase yang dipakai:
#   - id.kantincerdas.oauth://auth/google?kc_state=*
#   - id.kantincerdas.oauth://auth/verify-email
# Sinkronkan dengan `AUTH_GOOGLE_ENABLED` & `AUTH_GOOGLE_PRODUCTION_VERIFIED`
# pada backend. Set `false` di production sampai uji hosted AUTH-005A (A1-A4) lulus.
AUTH_GOOGLE_ENABLED=false

# Public HTTPS URL proyek Supabase BARU untuk verifikasi origin Google OAuth PKCE.
# Dibaca oleh: app/lib/features/auth/application/providers/google_oauth_provider.dart
# Sumber: Supabase Dashboard (proyek baru) -> Project Settings -> API Keys.
# Opsional: bila kosong, Flutter mengambilnya dari backend `GET /v1/auth/google/config`.
SUPABASE_URL=https://<NEW_SUPABASE_PROJECT_REF>.supabase.co

# ------------------------------------------------------------------------------
# 2. File Lokal Android Non-Git (TIDAK DITARUH DI `.env`, DI-IGNORE `.gitignore`)
# ------------------------------------------------------------------------------
# - Firebase Android (FCM):
#   Package Name permanen yang disepakati adalah `id.kantincerdas.app`.
#   File `google-services.json` sudah diunduh untuk `id.kantincerdas.app`.
#   CATATAN KOORDINASI: `app/android/app/build.gradle.kts` saat ini masih memakai
#   `com.kantincerdas.app` (belum diubah parsial). JANGAN menempatkan
#   `google-services.json` ke `app/android/app/google-services.json` sebelum
#   migrasi Package Name Android ke `id.kantincerdas.app` dilakukan terkoordinasi,
#   agar plugin `com.google.gms.google-services` tidak gagal package mismatch.
#   Autentikasi backend FCM HTTP v1 saat ini berstatus PENDING (pembuatan static
#   Service Account key diblokir kebijakan GCP; jangan bypass kebijakan keamanan).
#
# - Android Release Signing (hanya saat Android Signing Key resmi sudah dibuat):
#   Buat manual `app/android/key.properties` (jangan commit ke Git) berisi:
#     storeFile=app/upload-keystore.jks
#     storePassword=<KEYSTORE_PASSWORD>
#     keyAlias=<KEY_ALIAS>
#     keyPassword=<KEY_PASSWORD>
#
# ------------------------------------------------------------------------------
# 3. Referensi GitHub Actions Secrets (Untuk `.github/workflows/android-apk-prepare.yml`)
# ------------------------------------------------------------------------------
# Disimpan di GitHub Repository -> Settings -> Secrets and variables -> Actions:
# - ANDROID_KEYSTORE_BASE64      : base64 satu baris dari upload-keystore.jks
# - ANDROID_KEYSTORE_PASSWORD    : password keystore rilis
# - ANDROID_KEY_ALIAS            : alias key rilis
# - ANDROID_KEY_PASSWORD         : password key rilis
# - GOOGLE_SERVICES_JSON_BASE64  : (setelah migrasi ke `id.kantincerdas.app`)
# - SUPABASE_URL (opsional)      : boleh disimpan sebagai Repository Variable (vars)
#
# Contoh perintah build APK Release lokal (tanpa domain khusus, setelah key.properties siap):
#   flutter build apk --release \
#     --build-name="2.0.0" --build-number="1" \
#     --dart-define="API_BASE_URL=https://<your-railway-service>.up.railway.app" \
#     --dart-define="AUTH_EMAIL_LINK_HOST=" \
#     --dart-define="AUTH_GOOGLE_ENABLED=false" \
#     --dart-define="SUPABASE_URL=https://<NEW_SUPABASE_PROJECT_REF>.supabase.co"
