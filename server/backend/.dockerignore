# Secrets and local environment files (NEVER bake into image)
.env
.env.*
secrets/
*.pem
*.key
*.jks
*.keystore

# Local Dart tooling and caches
.dart_tool/
.pub-cache/
.packages
build/
coverage/
pubspec_overrides.yaml

# Tests and local docs not needed for runtime binary build
test/
AGENTS.md
README.md
*.md

# Editor, VCS, and temporary files
.git/
.github/
.idea/
.vscode/
*.iml
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
