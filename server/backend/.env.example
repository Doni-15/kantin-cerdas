# ==============================================================================
# A. APPLICATION
# ==============================================================================
APP_NAME=Kantin Cerdas API
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id_ID
APP_VERSION=1.0.0

# ==============================================================================
# B. HTTP SERVER
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
API_PREFIX=/v1
SERVER_REQUEST_TIMEOUT_SECONDS=30
SERVER_SHUTDOWN_TIMEOUT_SECONDS=30
SERVER_MAX_REQUEST_BODY_BYTES=10485760
SERVER_MAX_CONCURRENT_BODY_REQUESTS=10

# ==============================================================================
# C. SUPABASE CLOUD (Proyek: kantin-cerdas-server)
# ==============================================================================
SUPABASE_PROJECT_REF=diprwrdomyqrhllqlche
SUPABASE_URL=https://diprwrdomyqrhllqlche.supabase.co

# WAJIB DIISI DI .env: Salin dari Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# WAJIB DIISI DI .env (RAHASIA): Salin dari Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

SUPABASE_REQUEST_TIMEOUT_SECONDS=15
SUPABASE_MAX_RETRIES=2

# ==============================================================================
# D. AUTHENTICATION & JWT (ECC P-256 / ES256 via JWKS)
# ==============================================================================
AUTH_JWKS_URL=https://diprwrdomyqrhllqlche.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWT_ISSUER=https://diprwrdomyqrhllqlche.supabase.co/auth/v1
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWT_ALLOWED_ALGORITHMS=ES256
AUTH_JWKS_CACHE_TTL_SECONDS=3600
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_REQUIRE_EMAIL_VERIFIED=false

# ==============================================================================
# E. SECURITY
# ==============================================================================
SECURITY_ALLOWED_HOSTS=*
SECURITY_ENABLE_SECURITY_HEADERS=true

# ==============================================================================
# F. CORS (Wajib menyertakan Idempotency-Key untuk mutasi Flutter)
# ==============================================================================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,Idempotency-Key
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=600

# ==============================================================================
# G. RATE LIMITING
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ENTRIES=10000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=15

# ==============================================================================
# H. STORAGE & MEDIA (Selaras Migrasi 010: bucket kantin-media, maks 2 MB, kuota 200)
# ==============================================================================
STORAGE_BUCKET_NAME=kantin-media
STORAGE_MAX_UPLOAD_BYTES=2097152
STORAGE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
STORAGE_MAX_FILES_PER_USER=200
STORAGE_PUBLIC_BASE_URL=https://diprwrdomyqrhllqlche.supabase.co/storage/v1/object/public/kantin-media

# ==============================================================================
# I. LOGGING & OBSERVABILITY
# ==============================================================================
LOG_LEVEL=info
LOG_FORMAT=text
LOG_REQUEST_ENABLED=true
LOG_INCLUDE_STACK_TRACE=true