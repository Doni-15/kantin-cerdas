# ==============================================================================
# Kantin Cerdas Backend (Dart Shelf) — Environment Variables Template
# ==============================================================================
# Salin file ini menjadi `.env` lokal (di-ignore Git) untuk development, atau
# masukkan variabel yang dibutuhkan ke Environment Variables / Secrets Railway.
# JANGAN PERNAH menyimpan secret asli di Git, Docker image, atau Flutter (`app/`).
#
# Proyek Supabase baru telah dibuat: ganti seluruh placeholder `<...>` dengan
# nilai dari proyek Supabase baru Anda. Jangan menggunakan referensi proyek lama.
# ==============================================================================

# ==============================================================================
# A. APPLICATION
# ==============================================================================
APP_NAME=Kantin Cerdas API
# Nilai valid: development | staging | production
APP_ENV=development
# Production wajib false.
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id_ID
APP_VERSION=1.0.0

# ==============================================================================
# B. HTTP SERVER & RAILWAY HOSTING
# ==============================================================================
# Railway menyuntikkan variabel `PORT` secara otomatis saat container berjalan.
# `server/backend/docker-entrypoint.sh` memetakan `PORT` -> `SERVER_PORT` bila
# `SERVER_PORT` tidak disetel, serta mengikat `SERVER_HOST=0.0.0.0`.
# PENTING (Railway): JANGAN menyetel `SERVER_PORT` tetap di Railway Variables
# agar tidak menimpa `PORT` dinamis dari Railway. Nilai 8080 di bawah khusus
# development lokal.
# Healthcheck endpoint di `server/backend/railway.json`: /v1/health
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
API_PREFIX=/v1
SERVER_REQUEST_TIMEOUT_SECONDS=30
SERVER_SHUTDOWN_TIMEOUT_SECONDS=30
SERVER_MAX_REQUEST_BODY_BYTES=10485760
SERVER_MAX_CONCURRENT_BODY_REQUESTS=10

# ==============================================================================
# C. SUPABASE CLOUD (PROYEK SUPABASE BARU)
# ==============================================================================
# Sumber: Supabase Dashboard (proyek baru) -> Project Settings -> API Keys.
# Format Cloud yang divalidasi ketat oleh `SupabaseConfig`:
# - SUPABASE_URL: https://<NEW_SUPABASE_PROJECT_REF>.supabase.co
# - SUPABASE_PUBLISHABLE_KEY: wajib diawali `sb_publishable_` (Cloud) atau JWT (lokal)
# - SUPABASE_SECRET_KEY: wajib diawali `sb_secret_` (Cloud) atau JWT (lokal) — SERVER ONLY!
# - SUPABASE_PROJECT_REF: opsional; diturunkan otomatis dari SUPABASE_URL jika kosong
#   (atau `local` untuk Supabase loopback lokal di development).
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_REQUEST_TIMEOUT_SECONDS=15
SUPABASE_MAX_RETRIES=2

# ==============================================================================
# D. AUTHENTICATION, JWT/JWKS, & GOOGLE OAUTH VIA SUPABASE
# ==============================================================================
# Konsistensi nama variabel: kode `AuthConfig` memakai `AUTH_JWKS_URL` dan
# `AUTH_JWT_ISSUER` (BUKAN `SUPABASE_JWKS_URL`). Biarkan kosong agar otomatis
# diturunkan dari SUPABASE_URL:
# - AUTH_JWKS_URL default  : <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# - AUTH_JWT_ISSUER default: <SUPABASE_URL>/auth/v1
# Supabase Cloud wajib memakai asymmetric JWT signing key (ES256 atau RS256).
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWT_ALLOWED_ALGORITHMS=ES256
AUTH_JWKS_CACHE_TTL_SECONDS=3600
AUTH_CLOCK_SKEW_SECONDS=30
# Production WAJIB true agar akun belum verifikasi email tidak bisa mengakses API.
AUTH_REQUIRE_EMAIL_VERIFIED=true
# Isi hanya saat Flutter Web dan Shelf disajikan dari origin HTTPS yang sama.
AUTH_WEB_ORIGIN=
# Google OAuth Web Client ID & Client Secret dikonfigurasi di Supabase Dashboard
# (Authentication -> Sign In / Providers -> Google), BUKAN di env Shelf.
# Callback Redirect URI di Google Cloud Web Client:
#   https://<NEW_SUPABASE_PROJECT_REF>.supabase.co/auth/v1/callback
# Redirect URL allowlist yang terverifikasi tersimpan di Supabase Dashboard:
#   id.kantincerdas.oauth://auth/google?kc_state=*
#   id.kantincerdas.oauth://auth/verify-email
# Catatan wildcard Supabase: `?` mencocokkan 1 karakter non-separator (termasuk
# literal `?`) dan `*` mencocokkan nilai acak `kc_state`; Flutter memvalidasi
# ulang exact scheme/host/path/state di `matchesGoogleRedirect`.
AUTH_GOOGLE_ENABLED=true
# Pada APP_ENV=production, Google Login tetap nonaktif sampai flag ini diset true
# sesudah seluruh uji penerimaan hosted AUTH-005A (A1-A4) lulus.
AUTH_GOOGLE_PRODUCTION_VERIFIED=false
# Samakan dengan Email OTP Expiration di Supabase Auth Settings (detik).
AUTH_RECOVERY_LINK_TTL_SECONDS=3600

# ==============================================================================
# E. SECURITY & REVERSE PROXY (RAILWAY / NGINX / CADDY)
# ==============================================================================
# Railway (staging/production): ganti `*` dengan domain publik Railway WAJIB
# dipasangkan dengan `healthcheck.railway.app` agar probe `/v1/health` Railway
# tidak ditolak HTTP 403 `HOST_NOT_ALLOWED`, misal:
#   <your-railway-service>.up.railway.app,healthcheck.railway.app
SECURITY_ALLOWED_HOSTS=*
SECURITY_ENABLE_SECURITY_HEADERS=true
# Daftar IP reverse proxy tepercaya (pisahkan koma, IP literal bukan CIDR) agar
# RateLimitMiddleware membaca IP client asli dari header `X-Forwarded-For`.
# Biarkan KOSONG pada Railway (IP edge proxy Railway tidak statis) maupun saat
# koneksi langsung; untuk Nginx/Caddy di host yang sama gunakan `127.0.0.1`.
TRUSTED_PROXY_IPS=

# ==============================================================================
# F. CORS
# ==============================================================================
# Untuk Android-only production dapat diset CORS_ENABLED=false, atau ganti `*`
# dengan daftar origin HTTPS resmi (jangan gabungkan `*` dengan credentials=true).
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,Idempotency-Key
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=600

# ==============================================================================
# G. RATE LIMITING
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ENTRIES=10000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=15

# ==============================================================================
# H. STORAGE & MEDIA (SUPABASE PRIVATE BUCKETS)
# ==============================================================================
# Bucket privat `kantin-avatars` (migrasi 20261118000001) dan `kantin-media`
# (migrasi 20261121000001) diakses hanya lewat Shelf dengan SUPABASE_SECRET_KEY.
# STORAGE_PUBLIC_BASE_URL opsional; diturunkan otomatis dari SUPABASE_URL dan
# STORAGE_BUCKET_NAME bila kosong.
STORAGE_BUCKET_NAME=kantin-media
STORAGE_PUBLIC_BASE_URL=
STORAGE_MAX_UPLOAD_BYTES=2097152
STORAGE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
STORAGE_MAX_FILES_PER_USER=200

# ==============================================================================
# I. LOGGING & OBSERVABILITY
# ==============================================================================
# Production disarankan: LOG_LEVEL=info, LOG_FORMAT=json, LOG_INCLUDE_STACK_TRACE=false.
LOG_LEVEL=info
LOG_FORMAT=text
LOG_REQUEST_ENABLED=true
LOG_INCLUDE_STACK_TRACE=false

# ==============================================================================
# J. AI FOOD ASSISTANT — GEMINI API (DEFAULT DISABLED / CATALOG FALLBACK ONLY)
# ==============================================================================
# Lihat docs/development/ai/AI_FUTURE_ACTIVATION.md dan
# lib/src/modules/ai/domain/ai_provider_config.dart sebelum mengaktifkan Gemini.
# Sumber GEMINI_API_KEY: Google AI Studio (proyek Free Tier tanpa Cloud Billing).
# JANGAN menaruh GEMINI_API_KEY di Flutter.
AI_PROVIDER_ENABLED=false
AI_FREE_TIER_VERIFIED=false
AI_PRIVACY_AUDIENCE_VERIFIED=false
GEMINI_API_KEY=
# Contoh resmi saat aktivasi: https://generativelanguage.googleapis.com/v1beta
GEMINI_API_BASE_URL=
# Model Free Tier yang diizinkan oleh `AiProviderConfig.approvedFreeTierModel`.
# Verifikasi ketersediaan model ID di Gemini API live sebelum mengaktifkan.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_USER_LIMIT=10
# Wajib > 0 saat AI_PROVIDER_ENABLED=true; nilai 0 memicu fail-closed aman.
AI_PROJECT_DAILY_CAP=0
AI_PROJECT_RPM_LIMIT=15
AI_REQUEST_TIMEOUT_SECONDS=12
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ==============================================================================
# K. REALTIME & FIREBASE CLOUD MESSAGING HTTP V1
# ==============================================================================
# STATUS AUTENTIKASI BACKEND FCM: PENDING (DEFAULT DISABLED: FCM_ENABLED=false)
# - Firebase Cloud Messaging API (V1) sudah Enabled dan `google-services.json`
#   untuk `id.kantincerdas.app` sudah diunduh (menunggu integrasi Android).
# - Pembuatan Service Account private key JSON diblokir kebijakan organisasi
#   Google Cloud (`iam.disableServiceAccountKeyCreation`). JANGAN menonaktifkan
#   kebijakan keamanan GCP untuk memaksakan pembuatan static key.
# - Kode `HttpFcmTransport` saat ini masih membaca static key via env di bawah;
#   biarkan FCM_ENABLED=false dan FCM_WORKER_ENABLED=false hingga mekanisme
#   autentikasi keyless tanpa Cloud Billing yang aman untuk Railway Free
#   diputuskan/diimplementasikan (misal Workload Identity Federation via OIDC,
#   atau tetap memakai SSE + REST fallback).
# - JANGAN PERNAH menyimpan private key asli di repository Git atau Flutter.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Format PEM PKCS#8 (newline dapat ditulis sebagai `\n` satu baris di env server).
FCM_PRIVATE_KEY=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
FCM_API_BASE_URL=https://fcm.googleapis.com
FCM_REQUEST_TIMEOUT_SECONDS=10
FCM_MAX_RETRY_ATTEMPTS=5
FCM_WORKER_ENABLED=false
FCM_WORKER_POLL_INTERVAL_SECONDS=3
# SSE backend (`/v1/notifications/stream`) aktif otomatis. Set true hanya jika
# ingin mengaktifkan juga broadcast HTTP ke Supabase Realtime hosted.
REALTIME_SUPABASE_BROADCAST_ENABLED=false
REALTIME_SIGNAL_POLL_INTERVAL_MS=500
REALTIME_STREAM_HEARTBEAT_SECONDS=15
REALTIME_SESSION_RECHECK_SECONDS=5
